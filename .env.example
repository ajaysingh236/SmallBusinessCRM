# SmallBusinessCRM Environment Configuration Example
# Copy this file to .env before starting docker-compose

# Database SA Password for Microsoft SQL Server
DB_PASSWORD=StrongP@ssw0rd2026!

# JWT Secret Key (Must be at least 32 characters)
JWT_SIGNING_KEY=SmallBusinessCRM_Super_Secret_Key_For_Jwt_Auth_2026_Prod!

# Redis Cache Connection string (default docker internal: redis:6379)
REDIS_CONNECTION=redis:6379

# Seq Structured Logging endpoint (default docker internal: http://seq:5341)
SEQ_URL=http://seq:5341

# Client Port (default: 3000)
CLIENT_PORT=3000

# API Port (default: 5000)
API_PORT=5000
